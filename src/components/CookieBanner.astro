---
// Consent banner for analytics cookies (GA4). Astro puro, sin dependencias.
//
// GA4 NUNCA se carga en el <head>. Solo se inyecta vía loadGA4() y solo si el
// usuario lo acepta. La preferencia se guarda en la cookie okroot_cookie_consent
// (true / false), que se lee en cada carga para decidir si cargar GA4.
//
// [GA4-ID] es un placeholder: reemplazar por el ID real (G-XXXXXXXXXX) antes de
// publicar. Mientras siga entre corchetes, loadGA4() no hace ninguna petición.
---

<div id="cookie-banner" class="cookie-banner" role="region" aria-label="Aviso de cookies" hidden transition:persist>
  <div class="cookie-banner__card">
    <div class="cookie-banner__text">
      <p class="cookie-banner__title">Usamos cookies mínimas.</p>
      <p class="cookie-banner__body">
        Las necesarias siempre están activas. Las de analytics (Google Analytics
        4) solo se cargan si las aceptás. No recopilamos datos de tu perfil de
        salud.
      </p>
      <a class="cookie-banner__link" href="/cookies/">
        Ver política de cookies
      </a>
    </div>
    <div class="cookie-banner__actions">
      <button type="button" class="btn btn-ghost btn-sm" data-action="reject">
        Solo necesarias
      </button>
      <button type="button" class="btn btn-primary btn-sm" data-action="accept">
        Aceptar analytics
      </button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-banner__card {
    pointer-events: auto;
    width: 100%;
    max-width: 560px;
    padding: 24px;
    background: var(--color-ink);
    color: var(--root-cream);
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.15);
    transition:
      opacity 0.3s var(--ease-soft),
      transform 0.3s var(--ease-soft);
  }
  @media (min-width: 640px) {
    .cookie-banner {
      padding: 16px;
    }
    .cookie-banner__card {
      border-radius: 16px;
    }
  }
  .cookie-banner.is-leaving .cookie-banner__card {
    opacity: 0;
    transform: translateY(16px);
  }

  .cookie-banner__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    color: var(--root-cream);
  }
  .cookie-banner__body {
    margin: 8px 0 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.6;
    /* Aclarado para contraste legible sobre fondo oscuro */
    color: rgb(180, 178, 174);
  }
  .cookie-banner__link {
    display: inline-block;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--root-cream);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      color 150ms var(--ease-soft),
      text-decoration-color 150ms var(--ease-soft);
  }
  .cookie-banner__link:hover,
  .cookie-banner__link:focus-visible {
    color: #fff;
    text-decoration-color: currentColor;
  }

  .cookie-banner__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
  }
  @media (min-width: 640px) {
    .cookie-banner__actions {
      flex-direction: row;
      justify-content: flex-end;
    }
  }

  /* Botones del sistema .btn. En móvil ocupan el ancho; en desktop, auto. */
  .cookie-banner__actions .btn {
    flex: 1;
  }
  @media (min-width: 640px) {
    .cookie-banner__actions .btn {
      flex: 0 0 auto;
    }
  }
  /* La secundaria (.btn-ghost) vive sobre fondo oscuro: contorno claro, igual
     que adaptamos los links del footer. Mantiene la forma del sistema .btn. */
  .cookie-banner__actions :global(.btn-ghost) {
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .cookie-banner__actions :global(.btn-ghost:hover) {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-banner__card {
      transition: none;
    }
  }
</style>

<script>
  // Bundled by Astro to a hashed /_astro/*.js (served from 'self' — CSP-safe).
  // Owns the consent UI + the okroot_cookie_consent cookie. The actual GA4
  // injection lives in Analytics.astro (window.okrootLoadGA4) — we just trigger
  // it on accept. GA4 is never loaded without an explicit "true".
  const CONSENT_COOKIE = "okroot_cookie_consent";

  function readConsent(): string | null {
    const match = document.cookie
      .split("; ")
      .find((row) => row.indexOf(CONSENT_COOKIE + "=") === 0);
    return match ? match.split("=")[1] : null;
  }

  function writeConsent(value: "true" | "false") {
    const oneYear = 60 * 60 * 24 * 365;
    document.cookie = `${CONSENT_COOKIE}=${value}; Max-Age=${oneYear}; Path=/; SameSite=Lax; Secure`;
  }

  const banner = document.getElementById("cookie-banner");
  if (banner) {
    const dismiss = () => {
      banner.classList.add("is-leaving");
      window.setTimeout(() => {
        banner.hidden = true;
        banner.classList.remove("is-leaving");
      }, 300);
    };

    banner
      .querySelector('[data-action="accept"]')
      ?.addEventListener("click", () => {
        writeConsent("true");
        window.okrootLoadGA4?.();
        dismiss();
      });

    banner
      .querySelector('[data-action="reject"]')
      ?.addEventListener("click", () => {
        writeConsent("false");
        dismiss();
      });

    // Sin decisión previa: mostramos el banner. ("true"/"false" → ya decidido,
    // Analytics.astro ya cargó GA4 si correspondía.)
    if (readConsent() === null) {
      banner.hidden = false;
    }
  }
</script>
