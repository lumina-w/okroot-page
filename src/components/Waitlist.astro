---
import { EARLY_ACCESS_SPOTS } from "@/lib/consts";

const CONDITIONS = ["Celiaquía", "Diabetes", "Intolerancia a la lactosa", "Otra"];
---

<section id="waitlist" class="px-5 py-12 sm:px-6 lg:py-20">
  <div class="reveal mx-auto w-full max-w-[760px]" data-waitlist>
    <div
      class="overflow-hidden rounded-[32px] border p-8 sm:p-12"
      style="background:var(--root-violet-soft);border-color:var(--root-violet-mist)"
    >
      {/* Success state — hidden until the submit resolves */}
      <div data-wl-success hidden class="py-8 text-center">
        <div
          class="mx-auto flex h-16 w-16 items-center justify-center rounded-full text-3xl text-white"
          style="background:var(--root-violet)"
          aria-hidden
        >
          ✓
        </div>
        <h2
          class="mt-6 font-display font-extrabold leading-tight tracking-[-0.035em]"
          style="font-size:clamp(1.75rem, 3.5vw, 2.5rem);color:var(--root-ink)"
        >
          Ya estás dentro.
        </h2>
        <p class="mt-3 text-[17px] leading-relaxed" style="color:var(--root-mute)">
          Te avisamos cuando abra acceso.
        </p>
      </div>

      {/* Form state */}
      <div data-wl-form-wrap>
        <div class="text-center">
          <h2
            class="font-display font-extrabold leading-[1.05] tracking-[-0.04em]"
            style="font-size:clamp(2rem, 4.5vw, 3.25rem);color:var(--root-ink)"
          >
            Quiero acceso <span style="font-style:italic;color:var(--root-violet-deep)">anticipado</span>
          </h2>
          <p
            class="mx-auto mt-4 max-w-[460px] text-[17px] leading-relaxed"
            style="color:var(--root-mute)"
          >
            Entra a la lista de espera. Te escribimos cuando abramos los primeros cupos.
          </p>

          {
            EARLY_ACCESS_SPOTS > 0 && (
              <div
                class="mx-auto mt-5 inline-flex items-center gap-2 rounded-full px-4 py-2 text-[13.5px] font-semibold"
                style="background:#fff;color:var(--root-purple);border:1px solid var(--root-violet-mist)"
              >
                <span class="relative flex h-2 w-2">
                  <span
                    class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
                    style="background:var(--root-violet)"
                  />
                  <span
                    class="relative inline-flex h-2 w-2 rounded-full"
                    style="background:var(--root-violet)"
                  />
                </span>
                Solo quedan {EARLY_ACCESS_SPOTS} cupos de acceso anticipado
              </div>
            )
          }
        </div>

        <form data-wl-form class="mx-auto mt-9 max-w-[460px]" novalidate>
          {/* Email */}
          <label for="wl-email" class="block text-sm font-semibold" style="color:var(--root-ink)">
            Correo
          </label>
          <input
            id="wl-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="tu@correo.com"
            aria-describedby="wl-error"
            class="mt-2 w-full rounded-2xl px-4 py-3.5 text-[15px] outline-none transition-colors focus:border-[var(--root-violet)]"
            style="background:#fff;border:2px solid var(--root-line-strong);color:var(--root-ink)"
          />

          {/* Conditions */}
          <fieldset class="mt-6 border-0 p-0">
            <legend class="text-sm font-semibold" style="color:var(--root-ink)">
              ¿Cuál es tu restricción?
              <span class="font-normal" style="color:var(--root-faint)">(opcional)</span>
            </legend>
            <div class="mt-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
              {
                CONDITIONS.map((c) => (
                  <label
                    class="wl-cond flex cursor-pointer items-center gap-2.5 rounded-2xl px-4 py-3 text-[14.5px] transition-colors"
                    style="background:#fff;border:2px solid var(--root-line-strong);color:var(--root-ink-2)"
                  >
                    <input
                      type="checkbox"
                      name="condition"
                      value={c}
                      class="h-4 w-4 shrink-0 accent-[var(--root-violet)]"
                    />
                    {c}
                  </label>
                ))
              }
            </div>
          </fieldset>

          {/* Submit */}
          <button
            type="submit"
            data-wl-submit
            class="mt-7 flex w-full items-center justify-center rounded-full px-6 py-4 text-[16px] font-semibold text-white transition-opacity hover:opacity-90 disabled:opacity-60"
            style="background:var(--root-violet);box-shadow:0 10px 24px -10px rgba(148,51,234,0.6)"
          >
            Quiero comer sin adivinar
          </button>

          <p
            id="wl-error"
            data-wl-error
            hidden
            role="alert"
            class="mt-3 text-center text-[13px]"
            style="color:var(--root-danger)"
          >
            Algo falló. Intenta de nuevo en un momento.
          </p>

          <p
            class="mt-4 text-center text-[12.5px] leading-relaxed"
            style="color:var(--root-faint)"
          >
            Sin spam. Sin tarjeta. Solo te escribimos cuando hay algo que vale.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Minimal Supabase waitlist insert via PostgREST — no SDK, zero bundle cost.
  // The anon key is public by design; Row Level Security protects the table
  // (anon may INSERT only, never SELECT).
  const root = document.querySelector<HTMLElement>("[data-waitlist]");
  if (root) {
    const form = root.querySelector<HTMLFormElement>("[data-wl-form]")!;
    const submit = root.querySelector<HTMLButtonElement>("[data-wl-submit]")!;
    const errEl = root.querySelector<HTMLElement>("[data-wl-error]")!;
    const formWrap = root.querySelector<HTMLElement>("[data-wl-form-wrap]")!;
    const success = root.querySelector<HTMLElement>("[data-wl-success]")!;

    const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
    const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    // Highlight the chip border while a condition is checked.
    root.querySelectorAll<HTMLInputElement>('input[name="condition"]').forEach((cb) => {
      cb.addEventListener("change", () => {
        const label = cb.closest<HTMLElement>(".wl-cond");
        if (label) {
          label.style.borderColor = cb.checked ? "var(--root-violet)" : "var(--root-line)";
        }
      });
    });

    async function insertWaitlist(email: string, conditions: string[]) {
      if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
        console.warn("[OKRoot] Supabase no configurado. Submit simulado.", { email, conditions });
        return;
      }
      const res = await fetch(`${SUPABASE_URL}/rest/v1/okroot-waitlist`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
          Prefer: "return=minimal",
        },
        body: JSON.stringify({ email, conditions }),
      });
      // A duplicate email (409) counts as success — "you're already in".
      if (res.status === 409) return;
      if (!res.ok) throw new Error(`Supabase ${res.status}`);
    }

    const input = form.elements.namedItem("email") as HTMLInputElement;

    function showError(msg: string) {
      errEl.textContent = msg;
      errEl.hidden = false;
      input.setAttribute("aria-invalid", "true");
    }
    function clearError() {
      errEl.hidden = true;
      input.removeAttribute("aria-invalid");
    }
    input.addEventListener("input", clearError);

    let loading = false;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (loading) return;

      const email = input.value.trim();
      // Validate before submit — don't fail silently. `novalidate` disables the
      // native bubble, so we surface the error in the live region instead.
      if (!email || !input.checkValidity()) {
        showError("Escribe un correo válido para continuar.");
        input.focus();
        return;
      }
      clearError();

      loading = true;
      submit.disabled = true;
      submit.textContent = "Enviando…";

      const conditions = Array.from(
        root.querySelectorAll<HTMLInputElement>('input[name="condition"]:checked'),
      ).map((c) => c.value);

      try {
        await insertWaitlist(email, conditions);
        formWrap.hidden = true;
        success.hidden = false;
        // Move focus into the success panel so AT users learn it worked.
        success.setAttribute("tabindex", "-1");
        success.focus();
      } catch (err) {
        console.error("[OKRoot] waitlist submit failed", err);
        showError("Algo falló. Intenta de nuevo en un momento.");
        submit.disabled = false;
        submit.textContent = "Quiero comer sin adivinar";
        loading = false;
      }
    });
  }
</script>
