---
import PhoneMock from "@/components/PhoneMock.astro";

/* ─── Section ────────────────────────────────────────────────────────────── */
---

<section id="hero" class="px-5 pb-6 pt-0 sm:px-6 lg:px-6">
  {/* Hero card with radial gradient */}
  <div
    class="relative overflow-hidden rounded-[28px] border"
    style="background:radial-gradient(120% 90% at 0% 0%, #ece1ff 0%, #faf8f5 55%, #faf8f5 100%);border-color:var(--root-line);min-height:600px"
  >
    {/* Decorative blob */}
    <div
      aria-hidden
      class="pointer-events-none absolute -right-16 -top-20 h-[360px] w-[360px] rounded-full"
      style="background:radial-gradient(circle, rgba(148,51,234,0.18), transparent 70%)"
    />

    <div class="grid items-center gap-8 px-8 py-20 sm:px-12 sm:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
      {/* Left column */}
      <div class="relative z-10">
        <div class="load-rise" style="animation-delay:0ms">
          {/* Badge */}
          <div
            class="inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-semibold"
            style="background:rgba(148,51,234,0.10);color:var(--root-purple)"
          >
            <span
              class="h-1.5 w-1.5 rounded-full"
              style="background:var(--root-violet)"
            />
            Creado con Claude API · IA real, no base de datos
          </div>
        </div>

        <h1
          class="load-rise mt-6 font-display font-extrabold leading-[1.0] tracking-[-0.045em] text-ink"
          style="font-size:clamp(2.25rem, 5.4vw, 4.25rem);animation-delay:90ms"
        >
          Fotografía la etiqueta.
          <br />
          Sabe en segundos si{" "}
          <span
            style="font-style:italic;background:linear-gradient(135deg,#9433ea,#581c87);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text"
          >
            puedes comerla.
          </span>
        </h1>

        <p
          class="load-rise mt-6 max-w-[520px] text-[18px] leading-relaxed"
          style="color:var(--root-mute);animation-delay:220ms"
        >
          Para quien tiene celiaquía, diabetes o intolerancia a la lactosa —{" "}
          <strong style="color:var(--root-ink)">o las tres a la vez.</strong>
        </p>

        <div
          class="load-rise mt-9 flex flex-col items-start gap-3"
          style="animation-delay:320ms"
        >
          <a
            href="#waitlist"
            class="inline-flex items-center gap-2 rounded-full px-6 py-4 text-[15px] font-semibold text-white transition-opacity hover:opacity-90"
            style="background:var(--root-violet);box-shadow:0 8px 20px -8px rgba(148,51,234,0.5)"
          >
            Quiero comer sin adivinar →
          </a>
          <p class="text-[13px]" style="color:var(--root-faint)">
            <strong style="color:var(--root-mute)">Análisis en menos de 3 segundos</strong>
            {" · "}Sin tarjeta · Funciona offline.
          </p>
        </div>

        <div class="load-rise mt-11" style="animation-delay:430ms">
          {/* TrustPill */}
          <div
            class="flex max-w-[560px] items-center gap-3.5 rounded-full border px-[18px] py-3.5"
            style="background:#fff;border-color:var(--root-line)"
          >
            <div
              class="flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-full font-display text-sm font-extrabold text-white"
              style="background:linear-gradient(135deg,#9433ea,#581c87)"
            >
              VR
            </div>
            <p class="text-[12.5px] leading-snug" style="color:var(--root-mute)">
              <span class="font-semibold" style="color:var(--root-ink)">
                Hecho por Valentina Ramírez
              </span>
              {" "}— celíaca, diabética e intolerante a la lactosa. Full Stack Developer.
            </p>
          </div>
        </div>
      </div>

      {/* Right column — phone + floating verdict chips */}
      <div
        class="load-rise relative flex justify-center lg:justify-end"
        style="animation-delay:280ms"
      >
        <div class="relative">
          <PhoneMock />

          {/* VerdictChip: ok */}
          <div
            class="absolute hidden items-center gap-2.5 rounded-2xl border bg-white p-3 shadow-[0_12px_30px_-12px_rgba(20,20,20,0.18)] lg:flex"
            style="border-color:var(--root-line);top:80px;left:-10px;transform:rotate(-4deg)"
          >
            <span
              class="flex h-[38px] w-[38px] items-center justify-center rounded-full text-base font-bold text-white"
              style="background:var(--root-violet)"
            >
              ✓
            </span>
            <div>
              <div
                class="text-[11px] font-bold uppercase tracking-[0.08em]"
                style="color:var(--root-violet)"
              >
                OK
              </div>
              <div class="text-[13px] font-semibold" style="color:var(--root-ink)">
                Sin gluten · IG bajo
              </div>
            </div>
          </div>

          {/* VerdictChip: no */}
          <div
            class="absolute hidden items-center gap-2.5 rounded-2xl border bg-white p-3 shadow-[0_12px_30px_-12px_rgba(20,20,20,0.18)] lg:flex"
            style="border-color:var(--root-line);bottom:40px;right:-20px;transform:rotate(4deg)"
          >
            <span
              class="flex h-[38px] w-[38px] items-center justify-center rounded-full text-base font-bold text-white"
              style="background:#c44a4a"
            >
              ✗
            </span>
            <div>
              <div
                class="text-[11px] font-bold uppercase tracking-[0.08em]"
                style="color:#c44a4a"
              >
                No
              </div>
              <div class="text-[13px] font-semibold" style="color:var(--root-ink)">
                Contiene lactosa
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
