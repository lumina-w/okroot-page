---
import { APP_URL, PORTFOLIO_URL } from "@/lib/consts";
---

<footer
  class="border-t px-5 pb-10 pt-14 sm:px-6"
  style="background:var(--root-cream);border-color:var(--root-line)"
>
  <div class="mx-auto w-full max-w-[1100px]">
    <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center">
      <div>
        <span class="flex items-center gap-2">
          <img
            src="/favicon-32.png"
            alt=""
            width={28}
            height={28}
            loading="lazy"
            class="h-[28px] w-[28px]"
          />
          <span
            class="font-display text-[22px] font-extrabold tracking-[-0.04em]"
            style="color:var(--root-ink)"
          >
            root
          </span>
        </span>
        <p class="mt-3 max-w-xs text-sm leading-relaxed" style="color:var(--root-mute)">
          Fotografía la etiqueta. Sabe en segundos si puedes comerla.
        </p>
      </div>

      <nav class="flex flex-wrap items-center gap-x-7 gap-y-3 text-sm font-medium">
        <a
          href="/preguntas"
          class="py-1 transition-colors hover:text-primary"
          style="color:var(--root-ink-2)"
        >
          Preguntas
        </a>
        <a
          href="/contacto"
          class="py-1 transition-colors hover:text-primary"
          style="color:var(--root-ink-2)"
        >
          Contacto
        </a>
        <a
          href="/legal#privacidad"
          class="py-1 transition-colors hover:text-primary"
          style="color:var(--root-ink-2)"
        >
          Privacidad
        </a>
        <a
          href={APP_URL}
          class="py-1 transition-colors hover:text-primary"
          style="color:var(--root-ink-2)"
        >
          app.okroot.co
        </a>
        <a
          href={PORTFOLIO_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="wavival.dev (abre en una pestaña nueva)"
          class="py-1 transition-colors hover:text-primary"
          style="color:var(--root-ink-2)"
        >
          wavival.dev
        </a>
      </nav>
    </div>

    <div
      class="mt-10 border-t pt-6 text-center text-[12.5px]"
      style="border-color:var(--root-line);color:var(--root-mute)"
    >
      © 2026 OKRoot
    </div>
  </div>
</footer>
