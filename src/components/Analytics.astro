---
// Google Analytics 4 (gtag.js), CONSENT-GATED. GA4 never loads by default — only
// when the user has accepted analytics cookies (okroot_cookie_consent=true, set
// by CookieBanner.astro). The measurement ID lives in PUBLIC_GA_ID so it can
// differ per environment and stay out of source; when unset (local dev,
// previews) nothing loads — no tracking, no console noise.
//
// This is a *bundled* Astro script (not is:inline), so it ships as a hashed
// /_astro/*.js served from 'self' — the strict CSP in netlify.toml needs no
// 'unsafe-inline'. It injects the gtag.js loader at runtime, which is why
// script-src only has to allow https://www.googletagmanager.com.
//
// Exposes window.okrootLoadGA4() so the banner can start tracking the instant
// the user accepts, without a page reload. Idempotent — safe to call twice.
---

<script>
  declare global {
    interface Window {
      dataLayer: unknown[];
      gtag: (...args: unknown[]) => void;
      okrootLoadGA4: () => void;
      __okrootGaLoaded?: boolean;
    }
  }

  const id = import.meta.env.PUBLIC_GA_ID;

  window.okrootLoadGA4 = function okrootLoadGA4() {
    if (!id || window.__okrootGaLoaded) return;
    window.__okrootGaLoaded = true;

    const s = document.createElement("script");
    s.async = true;
    s.src = "https://www.googletagmanager.com/gtag/js?id=" + id;
    document.head.appendChild(s);

    window.dataLayer = window.dataLayer || [];
    function gtag(...args: unknown[]) {
      window.dataLayer.push(args);
    }
    window.gtag = gtag;
    gtag("js", new Date());
    gtag("config", id, {
      anonymize_ip: true,
      cookie_flags: "SameSite=None;Secure",
    });
  };

  // Returning visitor who already accepted: load GA4 right away.
  const consent = document.cookie
    .split("; ")
    .find((row) => row.indexOf("okroot_cookie_consent=") === 0);
  if (consent && consent.split("=")[1] === "true") {
    window.okrootLoadGA4();
  }

  // SPA (ClientRouter): gtag('config') solo cuenta el primer load. En cada
  // navegación posterior enviamos un page_view manual con la nueva ruta.
  let firstLoad = true;
  document.addEventListener("astro:page-load", () => {
    if (firstLoad) {
      firstLoad = false;
      return;
    }
    window.gtag?.("event", "page_view", {
      page_path: location.pathname,
      page_location: location.href,
      page_title: document.title,
    });
  });
</script>
