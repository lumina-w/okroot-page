---
import { PORTFOLIO_URL } from "@/lib/consts";
---

<section
  id="casos-de-exito"
  data-cases-root
  class="relative py-24 lg:py-32"
  style="background:var(--root-cream)"
>
  {/*
    Carrusel de casos de éxito — misma mecánica que PainSection:
    swipe horizontal en móvil, scroll-pin en desktop. Con una sola tarjeta
    el motor mide maxT<=0 y se desactiva, así que se ve estático (como ahora).
    Para añadir más casos: duplica un <article class="cases-card"> dentro del
    track. El scroll horizontal se activa solo en cuanto haya overflow real.
  */}
  <div class="cases-pin relative z-10" data-cases-pin>
    <div class="cases-stage" data-cases-stage>
      <div class="cases-track" data-cases-track>
        {/* Caso 01 — la fundadora, también usuaria número uno */}
        <article
          class="cases-card reveal grid items-center gap-10 overflow-hidden rounded-[28px] border p-8 sm:p-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 lg:p-14"
          style="background:linear-gradient(135deg, #ece1ff 0%, #faf8f5 100%);border-color:var(--root-line)"
        >
          {/* Portrait — top on mobile, left on desktop */}
          <div class="mx-auto w-full max-w-[320px]">
            <div
              class="founder-portrait relative w-full overflow-hidden rounded-3xl"
              style="background:linear-gradient(135deg,#9433ea,#581c87);aspect-ratio:4 / 5"
            >
              <img
                src="/valentina.webp"
                alt="Valentina Ramírez, fundadora de OKRoot"
                width={720}
                height={720}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />

              {/* Gradient overlay — black→transparent upward; appears on hover/focus */}
              <div class="founder-portrait__scrim" aria-hidden></div>

              {/* Caption — name always visible; meta + socials reveal on hover/focus */}
              <div class="founder-portrait__caption absolute inset-x-0 bottom-0 p-5 text-white">
                <p class="founder-portrait__name font-display text-[18px] font-bold tracking-[-0.01em]">
                  Valentina Ramírez
                </p>
                <div class="founder-portrait__meta">
                  <p class="mt-0.5 text-[13px] opacity-90">
                    @wavival · Full Stack Developer
                  </p>
                  <div class="mt-3 flex items-center gap-2.5">
                    <a
                      class="founder-portrait__icon"
                      href={PORTFOLIO_URL}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Portafolio wavival.dev (abre en una pestaña nueva)"
                    >
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden>
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18"></path>
                      </svg>
                    </a>
                    <a
                      class="founder-portrait__icon"
                      href="https://instagram.com/wavival"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Instagram @wavival (abre en una pestaña nueva)"
                    >
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden>
                        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                        <circle cx="12" cy="12" r="4"></circle>
                        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
                      </svg>
                    </a>
                    <a
                      class="founder-portrait__icon"
                      href="https://linkedin.com/in/wavival"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="LinkedIn wavival (abre en una pestaña nueva)"
                    >
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden>
                        <path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21H9z"></path>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* Story */}
          <div>
            <div
              class="text-[12px] font-bold uppercase tracking-[0.16em]"
              style="color:var(--root-violet)"
            >
              La creadora es también la usuaria número uno.
            </div>

            <h2
              class="mt-4 font-display font-extrabold leading-[1.05] tracking-[-0.035em]"
              style="font-size:clamp(1.75rem, 3.6vw, 2.75rem);color:var(--root-ink)"
            >
              Construí OKroot porque ninguna app{" "}
              <span style="font-style:italic;color:var(--root-violet)">
                resolvía lo que yo necesitaba.
              </span>
            </h2>

            <div
              class="mt-6 flex flex-col gap-4 text-[17px] leading-relaxed"
              style="color:var(--root-mute)"
            >
              <p>
                Soy celíaca, diabética e intolerante a la lactosa. Busqué una app que combinara las
                tres restricciones. No existía. Así que la construí.
              </p>
              <p>
                OKroot no es un experimento de wellness. Es una{" "}
                <strong style="color:var(--root-ink)">herramienta real</strong>,
                creada desde adentro.
              </p>
            </div>

            {/* First-person testimonial — treated as a pull-quote */}
            <blockquote
              class="mt-7 rounded-2xl border-l-4 py-4 pl-5 pr-4"
              style="border-color:var(--root-violet);background:rgba(148,51,234,0.06)"
            >
              <p
                class="font-display text-[18px] font-semibold italic leading-snug tracking-[-0.02em]"
                style="color:var(--root-ink)"
              >
                "Llevo 6 meses usándola cada vez que voy al súper. No he tenido un error
                desde que activé el perfil combinado."
              </p>
              <footer class="mt-2.5 text-[13px]" style="color:var(--root-mute)">
                Valentina · celíaca + diabética + intolerante a la lactosa
              </footer>
            </blockquote>
          </div>
        </article>

        {/* Próximos casos de éxito van aquí, como nuevos <article class="cases-card">. */}
      </div>
    </div>
  </div>
</section>

<style>
  /* Default = native horizontal swipe carousel (mobile / reduced-motion / no-JS).
     Con una sola tarjeta no hay overflow, así que se ve estática y centrada. */
  .cases-stage {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .cases-stage::-webkit-scrollbar { display: none; }

  .cases-track {
    display: flex;
    align-items: stretch;
    gap: 24px;
    /* Lead-in/out so the first and last card snap to the horizontal center. */
    padding-inline: max(20px, calc((100vw - min(92vw, 1200px)) / 2));
    padding-block: 4px;
  }

  .cases-card {
    flex: 0 0 auto;
    width: min(92vw, 1200px);
    scroll-snap-align: center;
  }

  /* Desktop = scroll-pinned. JS sets .cases-pin height; stage sticks and track translates. */
  @media (min-width: 1024px) {
    .cases-stage {
      position: sticky;
      top: 0;
      height: 100vh;
      align-items: center;
      overflow: hidden;
      scroll-snap-type: none;
    }
    .cases-track {
      align-items: center;
      gap: 40px;
      will-change: transform;
    }
    .cases-card {
      width: min(80vw, 1200px);
      transition: opacity 0.15s linear, transform 0.15s linear;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cases-card { transition: none; }
  }

  /* ── Founder portrait (caso 01) ── */
  /* Black→transparent gradient, hidden until hover/focus. */
  .founder-portrait__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.32) 32%,
      transparent 62%
    );
    opacity: 0;
    transition: opacity 0.35s var(--ease-soft);
    pointer-events: none;
  }
  .founder-portrait:hover .founder-portrait__scrim,
  .founder-portrait:focus-within .founder-portrait__scrim,
  .founder-portrait.is-open .founder-portrait__scrim {
    opacity: 1;
  }

  /* Name always legible (own shadow), even with the scrim hidden. */
  .founder-portrait__name {
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.55);
  }

  /* Meta + socials: hidden by default, slide/fade in on hover/focus. */
  .founder-portrait__meta {
    max-height: 0;
    opacity: 0;
    transform: translateY(6px);
    overflow: hidden;
    transition:
      max-height 0.35s var(--ease-soft),
      opacity 0.3s ease,
      transform 0.35s var(--ease-soft);
  }
  .founder-portrait:hover .founder-portrait__meta,
  .founder-portrait:focus-within .founder-portrait__meta,
  .founder-portrait.is-open .founder-portrait__meta {
    max-height: 90px;
    opacity: 1;
    transform: translateY(0);
  }

  /* On touch devices, hint the portrait is tappable. */
  @media (hover: none) {
    .founder-portrait {
      cursor: pointer;
    }
  }

  .founder-portrait__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 9999px;
    color: #fff;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    transition:
      background 0.2s var(--ease-soft),
      transform 0.2s var(--ease-soft);
  }
  .founder-portrait__icon:hover {
    background: rgba(255, 255, 255, 0.32);
    transform: translateY(-2px);
  }
  .founder-portrait__icon:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .founder-portrait__scrim,
    .founder-portrait__meta,
    .founder-portrait__icon {
      transition: none;
    }
  }
</style>

<script>
  // Carrusel de casos de éxito. Misma mecánica que PainSection: swipe nativo en
  // móvil; en desktop se "pinea" la etapa y el track se traslada con el scroll.
  // Solo se activa cuando hay overflow real (varias tarjetas) — con una sola
  // tarjeta queda estático.
  type Stage = HTMLElement & { _casesCleanup?: () => void };

  const setup = (root: HTMLElement) => {
    const pin = root.querySelector<HTMLElement>("[data-cases-pin]");
    const stage = root.querySelector<Stage>("[data-cases-stage]");
    const track = root.querySelector<HTMLElement>("[data-cases-track]");
    if (!pin || !stage || !track) return;
    const cards = Array.from(track.children) as HTMLElement[];
    if (!cards.length) return;

    const wide = window.matchMedia("(min-width: 1024px)");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    let active = false;
    let maxT = 0;
    let pinTop = 0;
    let ticking = false;

    const clearStyles = () => {
      pin.style.height = "";
      track.style.transform = "";
      track.style.paddingLeft = "";
      track.style.paddingRight = "";
      cards.forEach((c) => {
        c.style.opacity = "";
        c.style.transform = "";
      });
    };

    const render = () => {
      if (!active) return;
      const y = window.scrollY - pinTop;
      const p = Math.min(1, Math.max(0, y / maxT));
      const x = -p * maxT;
      track.style.transform = `translate3d(${x}px,0,0)`;

      const focus = stage.clientWidth * 0.5;
      cards.forEach((c) => {
        const cx = c.offsetLeft + c.offsetWidth / 2 + x;
        const d = Math.min(1, Math.abs(cx - focus) / (c.offsetWidth * 1.1));
        c.style.opacity = (1 - d * 0.78).toFixed(3);
        c.style.transform = `scale(${(1 - d * 0.04).toFixed(3)})`;
      });
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        render();
        ticking = false;
      });
    };

    const measure = () => {
      // Pin only on wide screens with motion allowed and real overflow.
      if (!wide.matches || reduce.matches) {
        active = false;
        clearStyles();
        return;
      }
      // Lead-in/out padding so the first and last card sit at the center.
      const pad = Math.max(0, (stage.clientWidth - cards[0].offsetWidth) / 2);
      track.style.paddingLeft = `${pad}px`;
      track.style.paddingRight = `${pad}px`;

      maxT = track.scrollWidth - stage.clientWidth;
      if (maxT <= 0) {
        active = false;
        clearStyles();
        return;
      }
      active = true;
      pin.style.height = `${window.innerHeight + maxT}px`;
      pinTop = pin.getBoundingClientRect().top + window.scrollY;
      render();
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", measure);
    wide.addEventListener("change", measure);
    reduce.addEventListener("change", measure);
    stage._casesCleanup = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", measure);
    };

    measure();
  };

  document.querySelectorAll<HTMLElement>("[data-cases-root]").forEach(setup);

  // Touch devices have no hover: first tap reveals the portrait overlay, tap
  // outside closes it. Desktop keeps the pure-CSS hover/focus behaviour.
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  const portraits = Array.from(
    document.querySelectorAll<HTMLElement>(".founder-portrait"),
  );

  portraits.forEach((portrait) => {
    portrait.addEventListener("click", (e) => {
      if (finePointer.matches) return; // desktop → hover handles it
      // Let the social links navigate instead of toggling.
      if ((e.target as HTMLElement).closest("a")) return;
      portrait.classList.toggle("is-open");
    });
  });

  // Tap outside any portrait closes the open overlays.
  document.addEventListener("click", (e) => {
    if (finePointer.matches) return;
    portraits.forEach((portrait) => {
      if (!portrait.contains(e.target as Node)) {
        portrait.classList.remove("is-open");
      }
    });
  });
</script>
