---
import Base from "@/layouts/Base.astro";
import PageShell from "@/components/PageShell.astro";

type Channel = {
  icon: "mail" | "phone" | "whatsapp" | "pin";
  label: string;
  value: string;
  href?: string;
  external?: boolean;
};

const CHANNELS: Channel[] = [
  {
    icon: "mail",
    label: "Correo",
    value: "contact@luminaw.co",
    href: "mailto:contact@luminaw.co",
  },
  {
    icon: "phone",
    label: "Teléfono",
    value: "+57 310 828 3088",
    href: "tel:+573108283088",
  },
  {
    icon: "whatsapp",
    label: "WhatsApp",
    value: "Escríbenos por WhatsApp",
    href: "https://wa.me/573108283088",
    external: true,
  },
  {
    icon: "pin",
    label: "Ubicación",
    value: "Antioquia, Colombia",
  },
];

const classes =
  "flex items-center gap-4 rounded-2xl border border-line bg-white/70 p-5 transition-colors";
---
<Base
  title="Contacto · OKRoot"
  description="¿Dudas, ideas o quieres colaborar con OKRoot? Estos son nuestros canales directos para hablar con el equipo."
>
  <PageShell
    eyebrow="Contacto"
    title="Hablemos"
    intro="¿Dudas, ideas o quieres colaborar? Estos son nuestros canales directos."
  >
    <div class="grid gap-4 sm:grid-cols-2">
      {CHANNELS.map(({ icon, label, value, href, external }) => {
        const iconMarkup = (
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
            {icon === "mail" && (
              <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden>
                <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2.5" />
                  <path d="M4 7l8 6 8-6" />
                </g>
              </svg>
            )}
            {icon === "phone" && (
              <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden>
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 3h3l2 5-2.5 1.5a12 12 0 0 0 5 5L21 15v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z"
                />
              </svg>
            )}
            {icon === "whatsapp" && (
              <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden>
                <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 20l1.4-4A8 8 0 1 1 9 18.6L4 20Z" />
                  <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5.6 0 1.2-.6 1.2-1.2l-2-1-1 1c-1.2-.5-2-1.3-2.5-2.5l1-1-1-2c-.6 0-1.2.6-1.2 1.2Z" />
                </g>
              </svg>
            )}
            {icon === "pin" && (
              <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden>
                <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 21s7-6.3 7-11a7 7 0 0 0-14 0c0 4.7 7 11 7 11Z" />
                  <circle cx="12" cy="10" r="2.5" />
                </g>
              </svg>
            )}
          </span>
        );
        const inner = (
          <>
            {iconMarkup}
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-muted">
                {label}
              </p>
              <p class="mt-0.5 font-medium text-ink">{value}</p>
            </div>
          </>
        );
        return href ? (
          <a
            href={href}
            {...(external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
            class={`${classes} hover:border-primary`}
          >
            {inner}
          </a>
        ) : (
          <div class={classes}>
            {inner}
          </div>
        );
      })}
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-line bg-white/70 p-6">
        <h2 class="font-display text-lg font-semibold text-ink">Tiempo de respuesta</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">
          Respondemos en menos de 24 horas hábiles. Te escribimos en español y, si
          lo prefieres, en inglés.
        </p>
      </div>
      <div class="rounded-2xl border border-line bg-white/70 p-6">
        <h2 class="font-display text-lg font-semibold text-ink">
          ¿Prefieres resolverlo al instante?
        </h2>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">
          Muchas dudas ya están resueltas en las{" "}
          <a
            href="/preguntas"
            class="font-semibold text-primary underline underline-offset-2 hover:text-accent"
          >
            preguntas frecuentes
          </a>.
        </p>
      </div>
    </div>

    <div class="mt-4 rounded-2xl border border-line bg-white/70 p-6">
      <h2 class="font-display text-lg font-semibold text-ink">Colaboraciones y prensa</h2>
      <p class="mt-2 text-[15px] leading-relaxed text-muted">
        ¿Eres nutricionista, creador de contenido o medio? Cuéntanos tu idea en{" "}
        <a
          href="mailto:contact@luminaw.co"
          class="font-semibold text-primary underline underline-offset-2 hover:text-accent"
        >
          contact@luminaw.co
        </a>{" "}
        y buscamos la forma de sumar.
      </p>
    </div>

    <div class="mt-8 rounded-[24px] border border-line bg-primary/5 p-7 text-center">
      <h2 class="font-display text-xl font-bold text-ink">¿Aún no estás en la lista?</h2>
      <p class="mx-auto mt-2 max-w-md text-[15px] leading-relaxed text-muted">
        Reserva tu cupo de acceso anticipado y te avisamos apenas abramos.
      </p>
      <a
        href="/#waitlist"
        class="mt-5 inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-[15px] font-semibold text-white transition-opacity hover:opacity-90"
      >
        Quiero mi cupo
      </a>
    </div>
  </PageShell>
</Base>
