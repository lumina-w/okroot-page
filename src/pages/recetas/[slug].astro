---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "@/layouts/Base.astro";
import RecetaCover from "@/components/RecetaCover.astro";

// Una página estática por receta. El param de ruta es el `slug` del
// frontmatter (URL amigable para SEO), no el id del archivo.
export const getStaticPaths = (async () => {
  const recetas = await getCollection("recetas", ({ data }) => data.publicada);
  return recetas.map((receta) => ({
    params: { slug: receta.data.slug },
    props: { receta },
  }));
}) satisfies GetStaticPaths;

const { receta } = Astro.props;
const { data } = receta;
const { Content } = await render(receta);

const total = data.tiempo_prep + data.tiempo_coccion;
const necesitaVerificar =
  Array.isArray(data.verificar) && data.verificar.length > 0;

const title = `${data.title} · Recetas OKroot`;
const description = `${data.descripcion} Sin gluten, sin lactosa, apta para diabetes. Verificada por OKroot.`;
---

<Base title={title} description={description}>
  <article class="mx-auto w-full max-w-3xl px-5 py-16 sm:px-8 lg:px-10 lg:py-24">
    {/* Breadcrumb */}
    <nav aria-label="Ruta de navegación" class="receta-crumbs">
      <a href="/">Inicio</a>
      <span aria-hidden="true">·</span>
      <a href="/recetas/">Recetas</a>
      <span aria-hidden="true">·</span>
      <span aria-current="page">{data.title}</span>
    </nav>

    {/* Portada ilustrada */}
    <div class="receta-banner mt-6">
      <RecetaCover categoria={data.categoria} size="bento" />
    </div>

    {/* Encabezado */}
    <header class="mt-8">
      <span class="receta-cat">{data.categoria}</span>
      <h1
        class="mt-3 font-display text-4xl font-bold leading-tight tracking-tight text-ink sm:text-5xl"
      >
        {data.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">{data.descripcion}</p>

      {/* Badges de restricción */}
      <div class="mt-6 flex flex-wrap gap-2">
        {data.restricciones.celiaca && <span class="receta-badge">Sin gluten</span>}
        {data.restricciones.lactosa && <span class="receta-badge">Sin lactosa</span>}
        {data.restricciones.diabetes && (
          <span class="receta-badge">Apto diabetes</span>
        )}
        {necesitaVerificar && (
          <span class="receta-badge receta-badge--warn">Verificar sustitución</span>
        )}
      </div>

      {/* Tiempo y porciones */}
      <dl class="receta-meta mt-8">
        <div>
          <dt>Preparación</dt>
          <dd>{data.tiempo_prep} min</dd>
        </div>
        <div>
          <dt>Cocción</dt>
          <dd>{data.tiempo_coccion === 0 ? "Sin cocción" : `${data.tiempo_coccion} min`}</dd>
        </div>
        <div>
          <dt>Total</dt>
          <dd>{total} min</dd>
        </div>
        <div>
          <dt>Porciones</dt>
          <dd>{data.porciones}</dd>
        </div>
        <div>
          <dt>Dificultad</dt>
          <dd>{data.dificultad}</dd>
        </div>
      </dl>
    </header>

    {/* Aviso de verificación, antes de los ingredientes */}
    {
      necesitaVerificar && (
        <aside class="receta-verificar mt-10" role="note">
          <p class="receta-verificar__title">
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
            </svg>
            Esta receta tiene ingredientes que requieren verificación
          </p>
          <p class="receta-verificar__lead">
            Lee las notas antes de preparar. Verifica:
          </p>
          <ul class="receta-verificar__list">
            {data.verificar!.map((v) => (
              <li>{v}</li>
            ))}
          </ul>
        </aside>
      )
    }

    {/* Nota médica destacada */}
    {
      data.notas_medicas && (
        <aside class="receta-medica mt-10">
          <p class="receta-medica__eyebrow">Nota médica</p>
          <p class="receta-medica__body">{data.notas_medicas}</p>
        </aside>
      )
    }

    {/* Cuerpo markdown */}
    <div class="receta-prose mt-12">
      <Content />
    </div>

    {data.fuente_inspiracion && (
      <p class="receta-fuente mt-12">Inspiración: {data.fuente_inspiracion}</p>
    )}

    {/* CTA final */}
    <div class="receta-cta mt-16">
      <p class="receta-cta__text">
        <span class="receta-brand"
          ><span class="receta-brand__ok">OK</span><span class="receta-brand__root"
            >root</span
          ></span
        > verifica automáticamente los ingredientes de cualquier producto según
        tu perfil.
      </p>
      <a href="/#lista-de-espera" class="btn btn-primary btn-lg">
        Quiero acceso anticipado
      </a>
    </div>
  </article>
</Base>

<style>
  /* ── Breadcrumb ── */
  .receta-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .receta-crumbs a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      color 150ms var(--ease-soft),
      text-decoration-color 150ms var(--ease-soft);
  }
  .receta-crumbs a:hover,
  .receta-crumbs a:focus-visible {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }
  /* Links dentro del cuerpo markdown — mismo estilo canónico. */
  .receta-prose :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      color 150ms var(--ease-soft),
      text-decoration-color 150ms var(--ease-soft);
  }
  .receta-prose :global(a:hover),
  .receta-prose :global(a:focus-visible) {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }
  .receta-crumbs [aria-current="page"] {
    color: var(--color-ink);
  }

  .receta-cat {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
  }

  /* ── Portada ── */
  .receta-banner {
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid var(--color-line);
  }

  /* ── Badges ── */
  .receta-badge {
    border-radius: 9999px;
    padding: 0.25rem 0.625rem;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.75rem;
    background: var(--root-violet-soft);
    color: var(--color-primary);
  }
  .receta-badge--warn {
    background: #fff8e7;
    color: #92610a;
    border: 1px solid #f5d88a;
  }

  /* ── Meta (tiempo / porciones) ── */
  .receta-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    padding: 1.25rem 1.5rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    margin-inline: 0;
  }
  .receta-meta dt {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .receta-meta dd {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-ink);
  }

  /* ── Aviso de verificación ── */
  .receta-verificar {
    background: #fff8e7;
    border: 1px solid #f5d88a;
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
  }
  .receta-verificar__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9375rem;
    color: #92610a;
  }
  .receta-verificar__lead {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: #7a5208;
  }
  .receta-verificar__list {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.6;
    color: #7a5208;
  }

  /* ── Nota médica (mismo trato que datos sensibles en /privacidad) ── */
  .receta-medica {
    border-left: 3px solid var(--color-primary);
    background: var(--root-violet-soft);
    border-radius: 0 0.75rem 0.75rem 0;
    padding: 20px 24px;
  }
  .receta-medica__eyebrow {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
  }
  .receta-medica__body {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink);
  }

  /* ── Cuerpo markdown ── */
  .receta-prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.625rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-top: 2.5rem;
  }
  .receta-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .receta-prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-ink);
    margin-top: 1.5rem;
  }
  .receta-prose :global(p) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-2);
    margin-top: 1rem;
  }
  .receta-prose :global(ul),
  .receta-prose :global(ol) {
    margin-top: 1rem;
    padding-left: 1.5rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-2);
  }
  .receta-prose :global(li) {
    margin-top: 0.5rem;
  }
  .receta-prose :global(li::marker) {
    color: var(--color-primary);
  }
  .receta-prose :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  .receta-fuente {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-faint);
  }

  /* ── CTA final ── */
  .receta-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
    background: var(--root-violet-soft);
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    padding: 3rem 1.5rem;
  }
  .receta-cta__text {
    max-width: 40ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.35;
    color: var(--color-ink);
  }
  /* OKroot wordmark — mirrors the navbar logo (OK 800 violet · root 500 ink). */
  .receta-brand {
    letter-spacing: -0.04em;
  }
  .receta-brand__ok {
    font-weight: 800;
    color: var(--color-primary);
  }
  .receta-brand__root {
    font-weight: 500;
    color: var(--color-ink);
  }
</style>
