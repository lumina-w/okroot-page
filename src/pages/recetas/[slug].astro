<script>
  // ── Checkbox de ingredientes ──
  // La sección #ingredientes del markdown trae una <ul>. La convertimos en lista
  // marcable; el estado persiste en localStorage por receta + índice.
  const article = document.querySelector<HTMLElement>(".receta-wrap");
  const slug = article?.dataset.slug ?? "";
  const ingH = document.getElementById("ingredientes");
  if (ingH) {
    let el = ingH.nextElementSibling;
    while (el && el.tagName !== "UL") el = el.nextElementSibling;
    if (el) {
      el.classList.add("receta-ingredientes");
      el.querySelectorAll("li").forEach((li, i) => {
        const key = `receta:${slug}:ing:${i}`;
        const checked = localStorage.getItem(key) === "1";
        if (checked) li.classList.add("is-checked");
        // Checkbox semantics so AT announces the checked/unchecked state, not
        // just "button" with no state (the visual is the .is-checked strike).
        li.setAttribute("role", "checkbox");
        li.setAttribute("tabindex", "0");
        li.setAttribute("aria-checked", checked ? "true" : "false");
        const toggle = () => {
          const on = li.classList.toggle("is-checked");
          li.setAttribute("aria-checked", on ? "true" : "false");
          localStorage.setItem(key, on ? "1" : "0");
        };
        li.addEventListener("click", toggle);
        li.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            toggle();
          }
        });
      });
    }
  }

  // ── Botón imprimir ──
  document
    .getElementById("receta-print")
    ?.addEventListener("click", () => window.print());

  // ── Scroll-spy del TOC ──
  // Observa los destinos a los que apunta el TOC: ## del markdown + las cards
  // (#beneficios, #notas) que viven fuera de .receta-prose.
  const links = document.querySelectorAll<HTMLAnchorElement>(".receta-toc__link");
  const heads = [...links]
    .map((l) => (l.dataset.id ? document.getElementById(l.dataset.id) : null))
    .filter((el): el is HTMLElement => el !== null);
  if (heads.length && links.length) {
    links[0].classList.add("is-active");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((link) =>
              link.classList.toggle(
                "is-active",
                link.dataset.id === entry.target.id,
              ),
            );
          }
        });
      },
      { rootMargin: "-20% 0px -70% 0px", threshold: 0 },
    );
    heads.forEach((h) => observer.observe(h));
  }
</script>
