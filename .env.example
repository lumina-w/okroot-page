# Supabase — waitlist form capture.
# Project → Settings → API. The anon/public key is safe to expose in the client;
# Row Level Security (see supabase/waitlist.sql) is what protects the data.
# Astro exposes only vars prefixed PUBLIC_ to client-side scripts.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
